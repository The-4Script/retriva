FIREBASE_PROJECT_ID=
# Optional but recommended: a Firebase service-account JSON (raw or base64-encoded)
# for the SAME project as FIREBASE_PROJECT_ID. Without this, auth token verification
# still works, but the persistent AI response cache, the AI rate-limit circuit
# breaker, and the /api/offline presence write are silently skipped.
# Get it from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=
GROQ_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=