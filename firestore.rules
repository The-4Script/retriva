rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'durvesh.thorat999@gmail.com'
      );
    }
    
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }
    
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated();
      // Require auth and validate some base fields. (More complex moderation done server-side)
      allow create: if isAuthenticated() && request.resource.data.keys().hasAll(['title', 'description', 'type', 'reporterId', 'status']);
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.reporterId || (request.resource.data.status == 'RESOLVED' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reporterId;
    }

    match /chats/{chatId} {
      // Allow global chat read, or participant read
      allow read: if isAuthenticated() && (chatId == 'global' || request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (chatId == 'global' || request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (chatId == 'global' || request.auth.uid in resource.data.participants);
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (chatId == 'global' || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          (
            (chatId == 'global' || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) 
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );
      }
    }
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // manage via a trusted Cloud Function / Admin SDK only, never the client
    }
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }
    match /siteConfig/{docId} {
      allow read: if true; // needed pre-login to show maintenance banner
      allow write: if isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
